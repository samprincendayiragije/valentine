# Public values only. The anon key is designed to be public; Row Level Security protects the data.
# Never put a service_role key or any other secret in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: switches on Reels -> Discover (YouTube search). Restrict the key to your site and to the YouTube Data API v3.
VITE_YOUTUBE_API_KEY=
